# Base URL of the API. In development leave empty to use the Vite proxy (/api → localhost:5000).
# In production (Vercel) set it to your backend, e.g. https://srkians-api.onrender.com/api/v1
VITE_API_URL=
# Socket.io origin (defaults to the API origin, or same-origin in development)
VITE_SOCKET_URL=
# Public site URL used for canonical links / share URLs (e.g. https://srkians.in)
VITE_SITE_URL=http://localhost:5173
# Dev proxy target
VITE_DEV_API_TARGET=http://localhost:5000
