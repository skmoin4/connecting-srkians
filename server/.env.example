# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/srkians?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Frontend origin(s), comma-separated. Used for CORS, email links and sitemap URLs.
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for dev-local upload URLs)
SERVER_URL=http://localhost:5000

# Cross-site cookies (Vercel frontend + Render API) need SameSite=None and Secure in production.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# ─── Cloudinary (image uploads) ─────────────────────────────────────────
# Without these, development stores uploads in server/uploads; production refuses uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ALLOW_LOCAL_UPLOADS=false

# ─── Firebase Cloud Messaging (optional push) ───────────────────────────
# Also run: npm install firebase-admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── SMTP (password reset / email verification) ─────────────────────────
# Without SMTP, emails are printed to the server console. Laragon ships Mailpit: host=127.0.0.1 port=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SRKians <no-reply@yourdomain.com>"

# ─── Seed ───────────────────────────────────────────────────────────────
# SEED_ADMIN_PASSWORD=
# DISABLE_JOBS=false
